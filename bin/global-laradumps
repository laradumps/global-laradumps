#!/usr/bin/env php
<?php

use LaraDumps\GlobalLaraDumps\Commands\BuildCommand;
use LaraDumps\GlobalLaraDumps\Commands\InstallCommand;
use LaraDumps\GlobalLaraDumps\Commands\UninstallCommand;
use LaraDumps\GlobalLaraDumps\Commands\UpgradeCommand;
use Symfony\Component\Console\Application;

if (file_exists(__DIR__.'/../../../autoload.php')) {
    require __DIR__.'/../../../autoload.php';
} else {
    require __DIR__.'/../vendor/autoload.php';
}

$app = new Application('Global LaraDumps Installer', '2.0.0');

$commands = [
    new BuildCommand(),
    new InstallCommand(),
    new UninstallCommand(),
    new UpgradeCommand(),
];

foreach ($commands as $command) {
    if (method_exists($app, 'addCommand')) {
        $app->addCommand($command);

        continue;
    }

    $app->add($command);
}

$app->run();
